# Normalize line endings: LF in the repo, native on checkout.
* text=auto

# Windows launchers must keep CRLF or cmd.exe can misparse labels/blocks.
*.bat text eol=crlf
*.cmd text eol=crlf

*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.dat  text

# OpenVSP models are XML but large and machine-written: never diff/merge them.
*.vsp3 -diff linguist-generated
*.png  binary
*.pkl  binary
